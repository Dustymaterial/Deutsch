# Full MongoDB URI including username and password. URL-encode special characters.
# Path must be /deutsch; place query options after a single ?.
# Example: mongodb+srv://username:password@cluster.example.com/deutsch?retryWrites=true&w=majority
MONGODB_URI=
SESSION_SECRET=
PORT=3001
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SENDER_EMAIL=

# Comma-separated usernames that can review reports (case-insensitive).
MODERATOR_USERNAMES=
# Hours a new account waits before it can create, join or post in groups (default 24; 0 in local dev).
GROUP_MIN_ACCOUNT_AGE_HOURS=
